/ {
	pdg0: pico-de-gallo {
		compatible = "odp,pico-de-gallo";
		status = "disabled";
	};

	pdg_i2c0: pdg-i2c {
		compatible = "odp,pico-de-gallo-i2c";
		clock-frequency = <400000>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	pdg_spi0: pdg-spi {
		compatible = "odp,pico-de-gallo-spi";
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};
};
